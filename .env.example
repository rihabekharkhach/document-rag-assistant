# Answer generation (groq | gemini | ollama)
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
GOOGLE_API_KEY=
LLM_RPM=20

# Reranker (Jina). JINA_RERANK_MODEL is optional: the code has a default
JINA_API_KEY=
JINA_RERANK_MODEL=

# Retrieval
RETRIEVAL_MODE=dense
RETRIEVE_CANDIDATES=30
FINAL_CHUNKS=5

# Vision for figure questions (Gemini)
VISION_ENABLED=true
VLM_MODEL=gemini-3.5-flash-lite
VLM_RPM=5

# OCR (Tesseract with French data)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGS=eng+fra

# Evaluation judge
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_RPM=4

# Interface
API_URL=http://127.0.0.1:8000